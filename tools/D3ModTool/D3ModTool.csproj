<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>D3ModTool</RootNamespace>
    <AssemblyName>D3ModTool</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- CrystalMpq.dll is a .NET Framework assembly; it is only used to read the 2.0.1 client's MPQs. -->
    <NoWarn>$(NoWarn);MSB3270</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\D3Casc.Lib\D3Casc.Lib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- docs-build: the ModKit's Markdown docs -> one self-contained HTML page -->
    <PackageReference Include="Markdig" Version="0.37.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="DocsTemplate.html" LogicalName="DocsTemplate.html" />
  </ItemGroup>

  <ItemGroup>
    <!-- Both are needed at runtime: CrystalMpq inflates through SharpZipLib. -->
    <Reference Include="CrystalMpq">
      <HintPath>libs\CrystalMpq.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="ICSharpCode.SharpZipLib">
      <HintPath>libs\ICSharpCode.SharpZipLib.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
